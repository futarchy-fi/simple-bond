# Copy to deploy/bond-notify.env on the VM and fill in real values.
# bond-notify.env is gitignored — never commit real secrets.

# HMAC key signing email verification / unsubscribe tokens.
# Generate with: openssl rand -hex 32
BOND_NOTIFY_HMAC_SECRET=change-me

# Address shown as the From: on notification emails (email is currently
# stubbed/no-op, but this is still used in logs and future providers).
BOND_NOTIFY_FROM=noreply@futarchy.ai

# Set on the production VM so the boot preflight FAILS FAST on a dangerous
# misconfig (no v6 chain, startBlock 0, default HMAC) instead of silently
# serving an empty read-model. Leave unset in dev/CI (warnings only).
BOND_NOTIFY_ENV=production

# v0.6 chain registration — the indexer only runs for a chain when its
# CONTRACT is set. START_BLOCK must be the real deploy block (0 → genesis scan).
MAINNET_V6_CONTRACT=0x6B24380B1980db3e2DfDd2b62f5ed3E7E88DFA43
MAINNET_V6_START_BLOCK=25139967
SEPOLIA_V6_CONTRACT=0xEeEB10a05b4D819d736DB7A130eaC0f36626F583
SEPOLIA_V6_START_BLOCK=10888612

# RPC endpoints. publicnode works for the indexer's 10k-block getLogs chunks,
# but is rate/limit-prone (incidents I2/I3/I9/I10). Prefer a KEYED endpoint
# (Alchemy/Infura) in production; the preflight warns when this is an unkeyed
# free host.
MAINNET_RPC=https://ethereum-rpc.publicnode.com
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
