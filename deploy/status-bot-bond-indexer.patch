+/**
+ * Check the SimpleBond mainnet indexer behind bond.futarchy.ai.
+ *
+ * Reads the indexer's own honest health endpoint (/api/notify/health), which
+ * since 2026-06 derives ok/degraded/down from per-chain block lag, dead-letter
+ * count and tick freshness (it no longer hardcodes "ok"). We map that onto the
+ * status-bot's component vocabulary and focus on mainnet (chain 1), since that
+ * is what bond.futarchy.ai serves.
+ *
+ * Returns { status: 'operational'|'degraded'|'outage', description }.
+ */
+export async function checkBondIndexer() {
+    const url = process.env.BOND_HEALTH_URL
+        || 'https://api.bond.futarchy.ai/api/notify/health';
+    const MAP = { ok: 'operational', degraded: 'degraded', down: 'outage' };
+    try {
+        let res;
+        try {
+            res = await fetch(url, {
+                headers: { 'User-Agent': 'FutarchyStatusBot/1.0' },
+                signal: AbortSignal.timeout(5000),
+            });
+        } catch (e) {
+            // Network error / timeout / DNS — the endpoint is unreachable.
+            return { status: 'outage', description: `health check failed: ${e.message}` };
+        }
+        let data = null, parseFailed = false;
+        try { data = await res.json(); } catch { parseFailed = true; }
+        // HTTP-level failure. The honest endpoint returns 503 only when the
+        // indexer is down, so any non-2xx is an outage regardless of body shape.
+        if (!res.ok) {
+            const why = data && data.status ? `reports ${data.status}` : `HTTP ${res.status}`;
+            return { status: 'outage', description: `health endpoint failing (${why})` };
+        }
+        if (parseFailed) {
+            // 200 but non-JSON (e.g. an HTML proxy/error page) — treat as outage.
+            return { status: 'outage', description: `health endpoint returned non-JSON (HTTP ${res.status})` };
+        }
+        if (!data || !data.status) {
+            return { status: 'outage', description: `health endpoint missing status field (HTTP ${res.status})` };
+        }
+        // This component monitors MAINNET specifically, so derive its status from the
+        // mainnet (chain 1) entry — NOT the multi-chain aggregate data.status (which
+        // also covers testnets, so a Sepolia hiccup must not fire a "mainnet" alert).
+        // Number() guards a string-vs-number chainId.
+        const mainnet = (data.indexer || []).find(s => Number(s.chainId) === 1);
+        if (!mainnet) {
+            // A mainnet monitor with no mainnet data has zero visibility — never green.
+            return {
+                status: data.status === 'down' ? 'outage' : 'degraded',
+                description: `no mainnet (chain 1) entry in /api/notify/health (overall: ${data.status})`,
+            };
+        }
+        if (mainnet.healthy) {
+            return {
+                status: 'operational',
+                description: `lag ${mainnet.blocksBehindHead} blocks, ${mainnet.deadLetters} dead-letters`,
+            };
+        }
+        // Mainnet present but unhealthy: outage if the indexer is fully down, else degraded.
+        if (!(data.status in MAP)) {
+            console.warn(`[Bot] /api/notify/health returned unmapped status "${data.status}"`);
+        }
+        const status = data.status === 'down' ? 'outage' : 'degraded';
+        const reasons = (mainnet.reasons || []).join('; ') || 'see /api/notify/health';
+        return { status, description: `unhealthy: ${reasons}` };
+    } catch (e) {
+        return { status: 'outage', description: `health check failed: ${e.message}` };
+    }
+}
