+/**
+ * Format the Bond Indexer (Mainnet) line for the heartbeat.
+ */
+export function formatBondIndexer(bond) {
+    const icon = bond.status === 'operational' ? '🟢'
+        : bond.status === 'degraded' ? '🟡' : '🔴';
+    return `\n<b>Bond Indexer (Mainnet)</b>\n${icon} ${bond.description}\n`;
+}
